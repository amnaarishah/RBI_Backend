# Copy to backend/.env and fill in. The real .env is NOT tracked by git.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ams_db
CORS_ORIGINS=http://localhost:3000
APP_ENV=development

# Login (see app/core/security.py)
# AUTH_REQUIRED=true            # login is OFF by default; set to true when deploying (and NEXT_PUBLIC_AUTH_REQUIRED=true in the frontend)
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# SECRET_KEY=                   # optional; if empty a random key is created once in backend/.secret_key
